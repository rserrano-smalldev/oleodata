# Copia este fichero a .env y ajusta si lo necesitas.
# Todos los valores por defecto funcionan tal cual para levantar la demo en local.

# --- Puertos expuestos en localhost (elegidos para minimizar colisiones) ---
API_PORT=8420
DB_PORT=5480
FRONTEND_PORT=5180

# --- Base de datos ---
POSTGRES_DB=oleodata
POSTGRES_USER=oleodata
POSTGRES_PASSWORD=oleodata_dev_password
# Usada por el contenedor de la API para conectar a la BD (host = nombre del servicio compose)
DATABASE_URL=postgresql+asyncpg://oleodata:oleodata_dev_password@db:5432/oleodata

# --- Usuario administrador único (sin OAuth ni multiusuario en el MVP) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password

# --- Open-Meteo (proveedor real, sin API key) ---
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Años de histórico importados automáticamente al dar de alta una parcela
# (el resto, hasta ~25 años, se trae bajo demanda con /backfill).
INITIAL_BACKFILL_YEARS_BACK=5

# Días de previsión meteorológica que se traen de Open-Meteo Forecast API.
FORECAST_DAYS_AHEAD=7

# --- RIA (Red de Información Agroclimática de Andalucía, proveedor real sin API key) ---
RIA_BASE_URL=https://www.juntadeandalucia.es
# Se usa automáticamente una estación RIA real solo si está a menos de esta
# distancia horizontal de la parcela (no la effective_distance_km ponderada
# por desnivel del descubrimiento genérico del módulo 2).
RIA_MAX_DISTANCE_KM=15

# --- URL interna que usa el frontend para llamar a la API dentro de docker compose ---
API_INTERNAL_URL=http://api:8000
