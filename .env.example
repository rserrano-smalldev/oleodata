# Copia este fichero a .env y ajusta si lo necesitas.
# Todos los valores por defecto funcionan tal cual para levantar la demo en local.

# --- Puertos expuestos en localhost (elegidos para minimizar colisiones) ---
API_PORT=8420
DB_PORT=5480
FRONTEND_PORT=5180

# --- Base de datos ---
POSTGRES_DB=oleodata
POSTGRES_USER=oleodata
POSTGRES_PASSWORD=oleodata_dev_password
# Usada por el contenedor de la API para conectar a la BD (host = nombre del servicio compose)
DATABASE_URL=postgresql+asyncpg://oleodata:oleodata_dev_password@db:5432/oleodata

# --- Usuario administrador único (sin OAuth ni multiusuario en el MVP) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password

# --- Open-Meteo (proveedor real, sin API key) ---
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# --- URL interna que usa el frontend para llamar a la API dentro de docker compose ---
API_INTERNAL_URL=http://api:8000
